PORT=3000

# Oracle ATP 접속 정보
# Wallet 방식 사용 시
DB_USER=ADMIN
DB_PASSWORD=
DB_CONNECTION_STRING=kcisdb_tp

# Wallet 경로 (서버에 배치된 위치)
TNS_ADMIN=/opt/kcis/wallet

# CORS 허용 도메인 (콤마 구분). 비워두면 모든 origin 허용 (개발용).
# 프로덕션 예시:
# CORS_ORIGINS=https://kcis-project.github.io,http://localhost:5500
CORS_ORIGINS=
